{
  "name": "themepark-dash-api",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "start": "npm run build && func start",
    "ingest:once": "node --env-file=.env --import tsx src/cli.ts",
    "dev": "node --env-file=.env --import tsx src/dev-server.ts"
  },
  "dependencies": {
    "@azure/functions": "^4.5.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
